#- Greeting
#-
#- Deferred scopes: a name bound to a body, called with values it feeds on.
#-
#- Run: aurora run examples/greeting.ar
#-
#- Output:
#-   [0 0 0 0 0 0 0 1]

ident hello = defer { 1; };

ident twice = defer { feed(0) * 2; };

ident bigger_of = defer {
  ident a = feed(0);
  ident b = feed(1);
  if a bigger b { a; } else { b; };
};

printb hello();
