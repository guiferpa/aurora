#- Every value is a tape as wide as the project says, and this project says nothing,
#- so it is the default eight bytes.
#-
#- Run "aurora run tiny -t 1" from the project root to see the same program in a
#- one-byte dialect, where a value holds a single byte and arithmetic wraps at 256.
#- The width belongs to the project rather than to a profile — it decides what the
#- source means, so it cannot differ between two ways of building the same file.

ident a = 200;

printb a;
printb a + 100;   #- wraps: 300 does not fit in one byte
printc a;
printc a + 100;
