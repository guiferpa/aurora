#- Branch
#-
#- "branch" is sugar for nested if/else: a list of "test: value" pairs and a
#- final fallback closed with ";". The first test that holds gives the value.
#-
#- Run: aurora run examples/branch.ar
#-
#- Output:
#-   [0 0 0 0 0 0 0 20]
#-   [0 0 0 0 0 0 3 231]

ident code = 2;

ident label = branch {
  code equals 1: 10,
  code equals 2: 20,
  code equals 3: 30,
  0;
};

printb label;

#- The fallback is what you get when nothing matches.
ident unknown = branch {
  code equals 8: 80,
  code equals 9: 90,
  999;
};

printb unknown;
