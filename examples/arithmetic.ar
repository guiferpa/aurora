#- Arithmetic
#-
#- Arithmetic reads a tape as an unsigned big-endian integer and writes the
#- result back as a tape, wrapping at the tape width. With the default 8-byte
#- tape that is 2^64; with --tape-size 1 it is 256.
#-
#- Run: aurora run examples/arithmetic.ar
#-
#- Output:
#-   [0 0 0 0 0 0 0 5]
#-   [0 0 0 0 0 0 0 6]
#-   [0 0 0 0 0 0 0 42]
#-   [0 0 0 0 0 0 0 5]
#-   [0 0 0 0 0 0 4 0]
#-   [0 0 0 0 0 0 0 14]
#-   [0 0 0 0 0 0 0 20]
#-   [0 0 0 0 0 0 0 5]
#-   2
#-   512
#-   18446744073709551611
#-   5
#-   [0 0 0 0 0 0 0 3]
#-   [0 0 0 0 0 0 1 0]

printb 2 + 3;
printb 10 - 4;
printb 6 * 7;
printb 20 / 4;
printb 2 ^ 10;

#- Multiplication binds tighter than addition.
printb 2 + 3 * 4;

#- Parentheses change the order.
printb (2 + 3) * 4;

#- Subtraction is left-associative: (10 - 3) - 2, not 10 - (3 - 2).
printb 10 - 3 - 2;

#- Division is too: (20 / 5) / 2, not 20 / (5 / 2).
printd 20 / 5 / 2;

#- Exponentiation is the one that goes the other way: 2 ^ (3 ^ 2).
printd 2 ^ 3 ^ 2;

#- A tape is unsigned, so negating takes the value away from zero and wraps.
#- With the default 8-byte tape that is 2^64 - 5; with --tape-size 1 it is 251.
printd -5;
printd 10 + -5;

#- Division truncates: there are no fractions, only bytes.
printb 7 / 2;

#- Wrapping: with one-byte tapes this is 0 instead of 256.
printb 255 + 1;
