#- Comments
#-
#- A comment starts with "#-" and runs to the end of the line. There is no
#- block comment form.
#-
#- Run: aurora run -s comments.ar
#-
#- Output:
#-   [0 0 0 0 0 0 0 3]

#- A comment on its own line.
ident a = 1;

ident b = 2;  #- ...or after an expression.

print a + b;

#- Commenting out code is the usual way to disable it:
#- print 999;
