#- Reels (strings)
#-
#- A reel is a run of tapes, one per character. "printb" shows the raw bytes;
#- "printc" reads them back as text.
#-
#- Run: aurora run examples/reels.ar
#-
#- Output:
#-   hello
#-   [0 0 0 0 0 0 0 104 0 0 0 0 0 0 0 101 0 0 0 0 0 0 0 108 0 0 0 0 0 0 0 108 0 0 0 0 0 0 0 111]
#-   a
#-   [0 0 0 0 0 0 0 97]
#-   b
#-   [0 0 0 0 0 0 0 0]
#-   A
#-   a

ident greeting = "hello";
printc greeting;
printb greeting;

#- A single character is one tape.
ident letter = "a";
printc letter;
printb letter;

#- Arithmetic on a reel uses its last tape, so "a" is 97 and this gives 98.
ident next = 1 + "a";
printc next;

#- An empty string is one empty tape.
ident nothing_to_say = "";
printb nothing_to_say;

#- printc also turns a number into the character it stands for.
printc 65;
printc 97;
