#- Assertions
#-
#- "assert" checks a condition and reports a message when it fails. It is only
#- accepted in files named *.test.ar — in any other file it is a compile error:
#-   assert can only be used in .test.ar files
#-
#- A failing assertion does not stop the run: every failure is collected and
#- reported at the end, with an exit code of 3.
#-
#- Run: aurora run -s assertions.test.ar
#-
#- Output: (no output; assertions only report failures)

assert(1 equals 1, "one equals one");
assert(2 bigger 1, "two is bigger than one");
assert(true, "true holds");

ident sum = defer {
  feed(0) + feed(1);
};

assert(sum(1, 2) equals 3, "sum adds the values fed to it");
assert(sum(10, 20) equals 30, "sum works with any values");

#- A failing assertion looks like this — uncomment to see the report:
#- assert(1 equals 2, "this one fails");
